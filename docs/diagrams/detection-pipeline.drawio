        <mxCell id="models" value="&lt;b&gt;models/scrfd80k_500m_640.onnx&lt;/b&gt;&lt;br&gt;ONNX Runtime runs the exported graph;&lt;br&gt;the built-in engines compile the topology in&lt;br&gt;(scrfd/topology.rs) and read weights by name (onnx/)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="det">

        <mxCell id="lbox" value="&lt;b&gt;scrfd::letterbox&lt;/b&gt; (CPU)&lt;br&gt;the resize half only&lt;br&gt;longest side → 640 · resize_image (triangle)&lt;br&gt;8-bit RGB, top-left — a quarter of the bytes" style="rounded=1;whiteSpace=wrap;html=1;convertToSvg=1;dashed=1;fillColor=#fff8ee;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="det">

        <mxCell id="ort" value="&lt;b&gt;fcs_ort::Session::run&lt;/b&gt;&lt;br&gt;ONNX Runtime · fastest, bundled in releases&lt;br&gt;9 tensors, sigmoid + reshape inside the graph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="det">
          <mxGeometry x="60" y="400" width="440" height="120" as="geometry" />

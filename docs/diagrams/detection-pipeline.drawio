<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.2.4">
  <diagram name="Detection pipeline">
    <mxGraphModel grid="1" gridSize="10" guides="1" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Face Crop Studio — per-image detection and crop pipeline" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;green — fcs-utils&lt;br&gt;orange — fcs-core&lt;br&gt;yellow diamond — decision&lt;br&gt;grey slanted / dashed — data and files" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1180" y="70" width="380" height="120" as="geometry" />
        </mxCell>

        <mxCell id="src" value="&lt;b&gt;Source image&lt;/b&gt;&lt;br&gt;JPEG · PNG · WebP · AVIF · RAW · HEIC" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="70" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="load" value="&lt;b&gt;load_image&lt;/b&gt; (fcs-utils)&lt;br&gt;decode + EXIF orientation&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;libjpeg-turbo for JPEG · RAW / HEIC behind features&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="180" width="360" height="80" as="geometry" />
        </mxCell>

        <mxCell id="det" value="YuNetDetector::detect_image (fcs-core)" style="swimlane;startSize=30;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=14;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="1520" height="780" as="geometry" />
        </mxCell>
        <mxCell id="decide" value="GPU model and GPU&lt;br&gt;preprocessor on&lt;br&gt;the same device?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="det">
          <mxGeometry x="600" y="50" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cpupre" value="&lt;b&gt;Preprocessor::preprocess&lt;/b&gt;&lt;br&gt;fit_input — one scale, centred letterbox bars&lt;br&gt;resize_image — fast_image_resize SIMD&lt;br&gt;BGR CHW tensor with the bars padded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="det">
          <mxGeometry x="100" y="210" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="gpupre" value="&lt;b&gt;WgpuPreprocessor::preprocess_into_tensor&lt;/b&gt;&lt;br&gt;letterbox resize + BGR CHW in a compute shader,&lt;br&gt;written straight into the model's input tensor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="det">
          <mxGeometry x="980" y="210" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="backend" value="&lt;b&gt;inference backend&lt;/b&gt;&lt;br&gt;ONNX Runtime · built-in CPU graph · WGSL GPU graph&lt;br&gt;12 head tensors → decode_yunet_outputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="det">
          <mxGeometry x="100" y="380" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="gpurun" value="&lt;b&gt;GpuYuNet::run_on_device_filtered&lt;/b&gt;&lt;br&gt;WGSL graph on the same queue · one download per level&lt;br&gt;decode with the score gate (skips cells below threshold²)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="det">
          <mxGeometry x="980" y="380" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="models" value="&lt;b&gt;models/*.onnx&lt;/b&gt;&lt;br&gt;YuNet 2023mar weights" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="det">
          <mxGeometry x="600" y="400" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="post" value="&lt;b&gt;apply_postprocess&lt;/b&gt;&lt;br&gt;score ≥ threshold · drop zero-area boxes · scale to source pixels&lt;br&gt;sort + top-k · NMS (spatial grid from 200 boxes, naive below) · merge close centres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="det">
          <mxGeometry x="380" y="550" width="760" height="90" as="geometry" />

        <mxCell id="det" value="FaceDetector::detect_image → ScrfdDetector::detect (fcs-core)" style="swimlane;startSize=30;html=1;align=left;spacingLeft=20;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=14;collapsible=0;" vertex="1" parent="1">

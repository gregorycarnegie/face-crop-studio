        </mxCell>
        <mxCell id="pre" value="&lt;b&gt;scrfd::preprocess&lt;/b&gt; (CPU) = letterbox + normalise&lt;br&gt;longest side → 640 · resize_image (triangle)&lt;br&gt;top-left on a 640×640 canvas, not centred&lt;br&gt;RGB CHW · (x − 127.5) / 128, padding included" style="rounded=1;whiteSpace=wrap;html=1;convertToSvg=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="det">
          <mxGeometry x="520" y="210" width="480" height="120" as="geometry" />
        </mxCell>

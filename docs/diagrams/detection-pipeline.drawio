        <mxCell id="gpurun" value="&lt;b&gt;scrfd::gpu::run&lt;/b&gt;&lt;br&gt;WGSL kernels · 66 steps in one submission&lt;br&gt;read back the 9 raw head maps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="det">

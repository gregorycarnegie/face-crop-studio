# Shell scripts and macOS plists must keep LF endings — macOS chokes on CRLF.
*.sh text eol=lf
*.plist text eol=lf
*.plist.in text eol=lf

# Fuzz seeds are exact bytes, including malformed signatures and encodings.
/fuzz/seeds/** -text

# Generated PTX is embedded byte for byte by the trainers and diffed by CI after regeneration.
*.ptx text eol=lf

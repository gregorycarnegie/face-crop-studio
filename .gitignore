/tools/cuda/linux/*.ll

# Models
models/
!/models/README.md
*.onnx

# Fixtures
# Only licence-clean fixtures are tracked. Using `fixtures/*` (not `fixtures/`)
# lets git descend into the re-included subdirs, so anything else dropped under
# fixtures/ stays local.
#
# Tracked: the README, the synthetic golden data, and two folders of Open Images
# photographs, all CC BY 2.0 and attributed: fixtures/oracle/ (the Python
# parity reference) and fixtures/images/ (the accuracy sample and general
# fixtures; see fixtures/images/ATTRIBUTION.md).
fixtures/*
!/fixtures/README.md
!/fixtures/golden/
!/fixtures/oracle/
!/fixtures/images/

# IDEs / Editors
.claude/
.codex
.idea/

